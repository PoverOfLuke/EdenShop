---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
---
<BaseLayout title="Admin" activeSection="dashboard">
  <Topbar slot="topbar" title="Admin" />

  <div id="admin-guard" class="dashboard-empty">Checking admin access…</div>

  <div id="admin-content" hidden>
    <div class="admin-tabs" role="tablist" aria-label="Admin sections">
      <button class="admin-tab" type="button" role="tab" data-tab="merchants" aria-selected="true">
        <span class="admin-tab__label">Merchants</span>
        <span class="admin-tab__count" id="count-merchants">—</span>
      </button>
      <button class="admin-tab" type="button" role="tab" data-tab="catalog" aria-selected="false">
        <span class="admin-tab__label">Catalog</span>
        <span class="admin-tab__count" id="count-catalog">—</span>
      </button>
      <button class="admin-tab" type="button" role="tab" data-tab="countries" aria-selected="false">
        <span class="admin-tab__label">Countries</span>
        <span class="admin-tab__count" id="count-countries">—</span>
      </button>
      <button class="admin-tab" type="button" role="tab" data-tab="cities" aria-selected="false">
        <span class="admin-tab__label">Cities</span>
        <span class="admin-tab__count" id="count-cities">—</span>
      </button>
    </div>

    <section id="tab-merchants" class="admin-panel" role="tabpanel">
      <div id="merchant-list" class="admin-list"></div>
    </section>

    <section id="tab-catalog" class="admin-panel" role="tabpanel" hidden>
      <div class="admin-card">
        <h2 class="admin-card__title">Add item</h2>
        <form id="catalog-add-form">
          <div class="admin-form-grid">
            <div class="field"><label>minecraft_id</label><input name="minecraftId" placeholder="minecraft:diamond" required /></div>
            <div class="field"><label>Name</label><input name="name" required /></div>
            <div class="field"><label>Category</label><input name="category" required /></div>
          </div>
          <div class="field"><label>Image URL</label><input name="imageUrl" placeholder="/items/diamond.png" required /></div>
          <div class="admin-form-actions">
            <span class="shop-edit__status" id="catalog-add-status"></span>
            <button class="btn btn--primary" type="submit">Add item</button>
          </div>
        </form>
      </div>

      <div class="field"><input type="text" id="catalog-filter" placeholder="Filter catalog…" /></div>
      <div id="catalog-list" class="admin-list"></div>
    </section>

    <section id="tab-countries" class="admin-panel" role="tabpanel" hidden>
      <div class="admin-card">
        <h2 class="admin-card__title">Add country</h2>
        <form id="country-add-form">
          <div class="admin-form-grid">
            <div class="field"><label>Name</label><input name="name" required /></div>
          </div>
          <div class="admin-form-actions">
            <span class="shop-edit__status" id="country-add-status"></span>
            <button class="btn btn--primary" type="submit">Add country</button>
          </div>
        </form>
      </div>
      <div id="country-list" class="admin-list"></div>
    </section>

    <section id="tab-cities" class="admin-panel" role="tabpanel" hidden>
      <div class="admin-card">
        <h2 class="admin-card__title">Add city</h2>
        <form id="city-add-form">
          <div class="admin-form-grid">
            <div class="field"><label>Country</label><select name="countryId" required></select></div>
            <div class="field"><label>Name</label><input name="name" required /></div>
          </div>
          <div class="admin-form-actions">
            <span class="shop-edit__status" id="city-add-status"></span>
            <button class="btn btn--primary" type="submit">Add city</button>
          </div>
        </form>
      </div>
      <div id="city-list" class="admin-list"></div>
    </section>
  </div>
</BaseLayout>

<script>
  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function setCount(id: string, n: number) {
    const el = document.getElementById(id);
    if (el) el.textContent = String(n);
  }

  // -- Tabs --
  document.querySelectorAll('.admin-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.admin-tab').forEach((b) => b.setAttribute('aria-selected', 'false'));
      btn.setAttribute('aria-selected', 'true');
      const tab = (btn as HTMLElement).dataset.tab;
      document.querySelectorAll('.admin-panel').forEach((p) => { (p as HTMLElement).hidden = p.id !== `tab-${tab}`; });
    });
  });

  // -- Merchants --
  interface MerchantRow { id: number; discord_username: string | null; display_name: string | null; approved: boolean; is_admin: boolean; shop_count: number; }

  async function loadMerchants() {
    const res = await fetch('/api/admin/merchants', { credentials: 'same-origin' });
    const { merchants } = (await res.json()) as { merchants: MerchantRow[] };
    setCount('count-merchants', merchants.length);

    const list = document.getElementById('merchant-list') as HTMLElement;
    list.innerHTML = merchants.map((m) => {
      const name = m.display_name ?? m.discord_username ?? `Merchant #${m.id}`;
      return `
      <div class="admin-row" data-id="${m.id}">
        <div class="admin-row__avatar">${escapeHtml(name.charAt(0).toUpperCase())}</div>
        <div class="admin-row__body">
          <div class="admin-row__title">${escapeHtml(name)}
            ${m.is_admin ? '<span class="badge badge--online">admin</span>' : ''}
            <span class="badge ${m.approved ? 'badge--online' : 'badge--offline'}">${m.approved ? 'approved' : 'pending'}</span>
          </div>
          <p class="admin-row__meta">@${escapeHtml(m.discord_username ?? '—')} · ${m.shop_count} shop${m.shop_count === 1 ? '' : 's'}</p>
        </div>
        <div class="admin-row__actions">
          <button class="btn btn--sm ${m.approved ? 'btn--danger' : 'btn--primary'}" type="button" data-action="${m.approved ? 'revoke' : 'approve'}" data-id="${m.id}">
            ${m.approved ? 'Revoke' : 'Approve'}
          </button>
        </div>
      </div>`;
    }).join('') || '<div class="admin-empty">No merchants yet.</div>';

    list.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const action = (btn as HTMLElement).dataset.action;
        await fetch(`/api/admin/merchants/${id}/${action}`, { method: 'POST', credentials: 'same-origin' });
        await loadMerchants();
      });
    });
  }

  // -- Catalog --
  interface CatalogRow { id: number; minecraft_id: string; name: string; category: string; image_url: string; active: boolean; }
  let catalogItems: CatalogRow[] = [];

  function renderCatalog(filter = '') {
    const q = filter.trim().toLowerCase();
    const filtered = catalogItems.filter((i) => !q || i.name.toLowerCase().includes(q) || i.minecraft_id.includes(q));
    const list = document.getElementById('catalog-list') as HTMLElement;
    list.innerHTML = filtered.slice(0, 200).map((i) => `
      <div class="admin-row ${i.active ? '' : 'admin-row--inactive'}" data-id="${i.id}">
        <span class="item-icon-wrap item-icon-wrap--sm"><img class="item-icon" src="${escapeHtml(i.image_url)}" alt="" /></span>
        <div class="admin-row__body">
          <div class="admin-row__title">${escapeHtml(i.name)}
            ${!i.active ? '<span class="badge badge--offline">inactive</span>' : ''}
          </div>
          <p class="admin-row__meta">${escapeHtml(i.category)} · ${escapeHtml(i.minecraft_id)}</p>
        </div>
        <div class="admin-row__actions">
          <button class="btn btn--sm" type="button" data-action="edit">Edit</button>
          <button class="btn btn--sm ${i.active ? 'btn--danger' : 'btn--success'}" type="button" data-action="toggle">${i.active ? 'Deactivate' : 'Activate'}</button>
        </div>
        <div class="admin-row__status shop-edit__status"></div>
        <div class="admin-row__edit item-edit-box" hidden></div>
      </div>
    `).join('') || '<div class="admin-empty">No catalog items match.</div>';

    list.querySelectorAll('.admin-row').forEach((card) => {
      const id = Number((card as HTMLElement).dataset.id);
      const editBtn = card.querySelector('[data-action="edit"]') as HTMLButtonElement;
      const toggleBtn = card.querySelector('[data-action="toggle"]') as HTMLButtonElement;
      const editBox = card.querySelector('.item-edit-box') as HTMLElement;
      const statusEl = card.querySelector('.admin-row__status') as HTMLElement;

      const fail = () => {
        statusEl.textContent = 'This item is no longer in the list — reloading.';
        statusEl.className = 'admin-row__status shop-edit__status shop-edit__status--error';
        void loadCatalog();
      };

      // No non-null assertion here: a stale button (the list re-rendered in
      // between) used to throw an opaque "cannot read properties of
      // undefined" instead of just refreshing.
      const item = () => catalogItems.find((i) => i.id === id);

      editBtn.addEventListener('click', () => {
        const current = item();
        if (!current) { fail(); return; }
        if (editBox.hidden && editBox.innerHTML === '') {
          editBox.innerHTML = `<form>
            <div class="admin-form-grid">
              <div class="field"><label>Name</label><input name="name" value="${escapeHtml(current.name)}" /></div>
              <div class="field"><label>Category</label><input name="category" value="${escapeHtml(current.category)}" /></div>
              <div class="field"><label>Image URL</label><input name="imageUrl" value="${escapeHtml(current.image_url)}" /></div>
            </div>
            <div class="admin-form-actions"><button class="btn btn--primary btn--sm" type="submit">Save</button></div>
          </form>`;
          const form = editBox.querySelector('form') as HTMLFormElement;
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = new FormData(form);
            const res = await fetch(`/api/admin/catalog/${id}`, {
              method: 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
              body: JSON.stringify({ name: data.get('name'), category: data.get('category'), imageUrl: data.get('imageUrl') }),
            });
            if (!res.ok) { statusEl.textContent = 'Could not save.'; statusEl.className = 'admin-row__status shop-edit__status shop-edit__status--error'; return; }
            await loadCatalog();
          });
        }
        editBox.hidden = !editBox.hidden;
      });

      toggleBtn.addEventListener('click', async () => {
        const current = item();
        if (!current) { fail(); return; }
        const endpoint = current.active ? `/api/admin/catalog/${id}` : `/api/admin/catalog/${id}/activate`;
        const res = await fetch(endpoint, { method: current.active ? 'DELETE' : 'POST', credentials: 'same-origin' });
        if (!res.ok) {
          const detail = (await res.json().catch(() => ({}))) as { error?: string };
          statusEl.textContent = detail.error ?? 'Could not update the item.';
          statusEl.className = 'admin-row__status shop-edit__status shop-edit__status--error';
          return;
        }
        await loadCatalog();
      });
    });
  }

  async function loadCatalog() {
    const res = await fetch('/api/admin/catalog', { credentials: 'same-origin' });
    const data = (await res.json()) as { items: CatalogRow[] };
    catalogItems = data.items;
    setCount('count-catalog', catalogItems.length);
    renderCatalog((document.getElementById('catalog-filter') as HTMLInputElement).value);
  }

  (document.getElementById('catalog-filter') as HTMLInputElement).addEventListener('input', (e) => {
    renderCatalog((e.target as HTMLInputElement).value);
  });

  (document.getElementById('catalog-add-form') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const status = document.getElementById('catalog-add-status') as HTMLElement;
    const res = await fetch('/api/admin/catalog', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ minecraftId: data.get('minecraftId'), name: data.get('name'), category: data.get('category'), imageUrl: data.get('imageUrl') }),
    });
    const result = await res.json();
    if (!res.ok) { status.textContent = result.error ?? 'Could not add.'; status.className = 'shop-edit__status shop-edit__status--error'; return; }
    status.textContent = 'Added.';
    status.className = 'shop-edit__status shop-edit__status--ok';
    form.reset();
    await loadCatalog();
  });

  // -- Countries (slugs are generated by the server, nothing to type here) --
  interface CountryRow { id: number; name: string; }
  let countries: CountryRow[] = [];

  async function loadCountries() {
    const res = await fetch('/api/admin/countries', { credentials: 'same-origin' });
    const data = (await res.json()) as { countries: CountryRow[] };
    countries = data.countries;
    setCount('count-countries', countries.length);

    const list = document.getElementById('country-list') as HTMLElement;
    list.innerHTML = countries.map((c) => `
      <div class="admin-row" data-id="${c.id}">
        <div class="admin-row__avatar">${escapeHtml(c.name.charAt(0).toUpperCase())}</div>
        <div class="admin-row__body">
          <div class="admin-row__title">${escapeHtml(c.name)}</div>
        </div>
        <div class="admin-row__actions">
          <button class="btn btn--sm btn--danger" type="button" data-action="delete">Delete</button>
        </div>
      </div>
    `).join('') || '<div class="admin-empty">No countries yet.</div>';

    list.querySelectorAll('[data-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn.closest('[data-id]') as HTMLElement).dataset.id;
        if (!confirm('Delete this country? Shops using it will show no location instead.')) return;
        await fetch(`/api/admin/countries/${id}`, { method: 'DELETE', credentials: 'same-origin' });
        await loadCountries();
        await populateCityCountrySelect();
      });
    });

    await populateCityCountrySelect();
  }

  async function populateCityCountrySelect() {
    const select = document.querySelector('#city-add-form [name="countryId"]') as HTMLSelectElement;
    select.innerHTML = countries.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
  }

  (document.getElementById('country-add-form') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const status = document.getElementById('country-add-status') as HTMLElement;
    const res = await fetch('/api/admin/countries', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ name: data.get('name') }),
    });
    const result = await res.json();
    if (!res.ok) { status.textContent = result.error ?? 'Could not add.'; status.className = 'shop-edit__status shop-edit__status--error'; return; }
    status.textContent = 'Added.';
    status.className = 'shop-edit__status shop-edit__status--ok';
    form.reset();
    await loadCountries();
  });

  // -- Cities --
  interface CityRow { id: number; country_id: number; name: string; }

  async function loadCities() {
    const res = await fetch('/api/admin/cities', { credentials: 'same-origin' });
    const data = (await res.json()) as { cities: CityRow[] };
    setCount('count-cities', data.cities.length);
    const countryName = (id: number) => countries.find((c) => c.id === id)?.name ?? '—';

    const list = document.getElementById('city-list') as HTMLElement;
    list.innerHTML = data.cities.map((c) => `
      <div class="admin-row" data-id="${c.id}">
        <div class="admin-row__avatar">${escapeHtml(c.name.charAt(0).toUpperCase())}</div>
        <div class="admin-row__body">
          <div class="admin-row__title">${escapeHtml(c.name)}</div>
          <p class="admin-row__meta">${escapeHtml(countryName(c.country_id))}</p>
        </div>
        <div class="admin-row__actions">
          <button class="btn btn--sm btn--danger" type="button" data-action="delete">Delete</button>
        </div>
      </div>
    `).join('') || '<div class="admin-empty">No cities yet.</div>';

    list.querySelectorAll('[data-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn.closest('[data-id]') as HTMLElement).dataset.id;
        if (!confirm('Delete this city?')) return;
        await fetch(`/api/admin/cities/${id}`, { method: 'DELETE', credentials: 'same-origin' });
        await loadCities();
      });
    });
  }

  (document.getElementById('city-add-form') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const status = document.getElementById('city-add-status') as HTMLElement;
    const res = await fetch('/api/admin/cities', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ countryId: data.get('countryId'), name: data.get('name') }),
    });
    const result = await res.json();
    if (!res.ok) { status.textContent = result.error ?? 'Could not add.'; status.className = 'shop-edit__status shop-edit__status--error'; return; }
    status.textContent = 'Added.';
    status.className = 'shop-edit__status shop-edit__status--ok';
    form.reset();
    await loadCities();
  });

  // -- Guard + boot --
  (async () => {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
      if (!res.ok) { window.location.replace('/login'); return; }
      const me = await res.json();
      if (!me.is_admin) {
        (document.getElementById('admin-guard') as HTMLElement).textContent = "You don't have access to this page.";
        return;
      }
      await loadMerchants();
      await loadCatalog();
      await loadCountries();
      await loadCities();
      (document.getElementById('admin-guard') as HTMLElement).hidden = true;
      (document.getElementById('admin-content') as HTMLElement).hidden = false;
    } catch {
      (document.getElementById('admin-guard') as HTMLElement).textContent = "Couldn't check admin access right now.";
    }
  })();
</script>
