---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
---
<BaseLayout title="Products" activeSection="products">
  <Topbar slot="topbar" title="Products">
    <div class="search-bar">
      <span class="search-bar__icon">⌕</span>
      <input id="product-search" type="text" placeholder="Search a product…" autocomplete="off" />
    </div>
  </Topbar>

  <p class="page-lede">
    All products currently for sale or wanted, from every shop. Filter by
    category, shop or offer type, then open a product to see the price and
    get to the shop.
  </p>

  <div class="toolbar">
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <div class="field" style="margin-bottom:0;"><select id="filter-category"><option value="">All categories</option></select></div>
      <div class="field" style="margin-bottom:0;"><select id="filter-shop"><option value="">All shops</option></select></div>
      <div class="field" style="margin-bottom:0;">
        <select id="filter-type">
          <option value="">Sells and/or buys</option>
          <option value="sell">For sale only</option>
          <option value="buy">Wanted only</option>
        </select>
      </div>
    </div>
    <span class="widget__meta" id="result-count" style="font-size:13px;"></span>
  </div>

  <div id="products-loading" class="dashboard-empty">Loading products…</div>
  <div class="product-grid" id="product-grid"></div>
  <div class="empty-state" id="empty-state" hidden>
    <div class="empty-state__icon"></div>
    No products match your search.
  </div>
</BaseLayout>

<script>
  interface ShopItem {
    id: number; minecraft_id: string; shop_name: string; shop_slug: string;
    quantity: number | null; sell_amount: number | null; sell_price: string | null;
    buy_amount: number | null; buy_price: string | null;
    catalog: { name: string; category: string; image_url: string } | null;
  }

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function itemIcon(catalog: { name: string; image_url: string } | null, fallbackName: string): string {
    const alt = escapeHtml(catalog?.name ?? fallbackName);
    const src = catalog?.image_url ?? '';
    return `<span class="item-icon-wrap">
      <img class="item-icon" src="${escapeHtml(src)}" alt="${alt}"
        onerror="this.style.display='none';this.parentElement.classList.add('item-icon-wrap--missing')" />
    </span>`;
  }

  function cardHtml(i: ShopItem): string {
    const name = i.catalog?.name ?? i.minecraft_id;
    const rows: string[] = [];
    if (i.sell_amount !== null && i.sell_price !== null) {
      rows.push(`<div class="trade-row"><div class="trade-row__left"><span class="trade-tag trade-tag--sell">sells</span>
        <span class="stock ${i.quantity === 0 ? 'stock--zero' : ''}">${i.quantity === 0 ? 'out of stock' : `${i.quantity} in stock`}</span></div>
        <span class="price__unit">${i.sell_price} Essence</span></div>`);
    }
    if (i.buy_amount !== null && i.buy_price !== null) {
      rows.push(`<div class="trade-row"><div class="trade-row__left"><span class="trade-tag trade-tag--buy">buys</span></div>
        <span class="price__unit">${i.buy_price} Essence</span></div>`);
    }
    return `<a class="product-card" href="/products/detail?id=${i.id}"
        data-name="${escapeHtml(name.toLowerCase())}" data-category="${escapeHtml(i.catalog?.category ?? '')}"
        data-shop="${escapeHtml(i.shop_slug)}" data-type="${i.sell_price !== null ? 'sell' : ''} ${i.buy_price !== null ? 'buy' : ''}">
      <div class="product-card__top">${itemIcon(i.catalog, i.minecraft_id)}
        <div><div class="product-card__name">${escapeHtml(name)}</div><div class="product-card__shop">${escapeHtml(i.shop_name)}</div></div></div>
      <div class="product-card__trades">${rows.join('')}</div>
    </a>`;
  }

  let allItems: ShopItem[] = [];

  function applyFilters() {
    const query = (document.getElementById('product-search') as HTMLInputElement).value.trim().toLowerCase();
    const category = (document.getElementById('filter-category') as HTMLSelectElement).value;
    const shop = (document.getElementById('filter-shop') as HTMLSelectElement).value;
    const type = (document.getElementById('filter-type') as HTMLSelectElement).value;

    const filtered = allItems.filter((i) => {
      const name = (i.catalog?.name ?? i.minecraft_id).toLowerCase();
      const matchesQuery = !query || name.includes(query);
      const matchesCategory = !category || i.catalog?.category === category;
      const matchesShop = !shop || i.shop_slug === shop;
      const itemType = `${i.sell_price !== null ? 'sell' : ''} ${i.buy_price !== null ? 'buy' : ''}`;
      const matchesType = !type || itemType.includes(type);
      return matchesQuery && matchesCategory && matchesShop && matchesType;
    });

    const grid = document.getElementById('product-grid') as HTMLElement;
    const empty = document.getElementById('empty-state') as HTMLElement;
    const count = document.getElementById('result-count') as HTMLElement;

    grid.innerHTML = filtered.map(cardHtml).join('');
    grid.style.display = filtered.length ? 'grid' : 'none';
    empty.hidden = filtered.length > 0;
    count.textContent = `${filtered.length} product${filtered.length === 1 ? '' : 's'}`;
  }

  (async () => {
    const loading = document.getElementById('products-loading') as HTMLElement;
    try {
      const res = await fetch('/api/products');
      const { items } = (await res.json()) as { items: ShopItem[] };
      allItems = items;

      const categorySelect = document.getElementById('filter-category') as HTMLSelectElement;
      const shopSelect = document.getElementById('filter-shop') as HTMLSelectElement;

      const categories = Array.from(new Set(items.map((i) => i.catalog?.category).filter(Boolean))).sort() as string[];
      for (const c of categories) categorySelect.add(new Option(c, c));

      const shops = Array.from(new Map(items.map((i) => [i.shop_slug, i.shop_name])).entries());
      for (const [slug, name] of shops) shopSelect.add(new Option(name, slug));

      loading.hidden = true;
      applyFilters();

      document.getElementById('product-search')!.addEventListener('input', applyFilters);
      categorySelect.addEventListener('change', applyFilters);
      shopSelect.addEventListener('change', applyFilters);
      document.getElementById('filter-type')!.addEventListener('change', applyFilters);
    } catch {
      loading.textContent = "Couldn't load products right now.";
    }
  })();
</script>
