---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
import { products, getProductBySlug, getShopBySlug } from '@/lib/mockData';
import { getCatalogItem } from '@/lib/items';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug as string);
if (!product) return Astro.redirect('/products');
const shop = getShopBySlug(product.shopSlug);
const item = getCatalogItem(product.minecraftId);
const displayName = item?.name ?? product.minecraftId;
---
<BaseLayout title={displayName} activeSection="products">
  <Topbar slot="topbar" title={displayName} />

  <p class="breadcrumb"><a href="/products">Products</a> / {displayName}</p>

  <div class="panel product-detail__panel">
    <span class="item-icon-wrap item-icon-wrap--lg">
      <img
        class="item-icon"
        src={item?.image_url}
        alt={displayName}
        onerror="this.style.display='none';this.parentElement.classList.add('item-icon-wrap--missing')"
      />
    </span>
    <div style="flex:1;">
      <h1 style="margin-bottom:4px;">{displayName}</h1>
      <div class="widget__meta">{item?.category ?? 'unknown category'} · {product.minecraftId}</div>

      <div class="trade-columns">
        <div class="trade-panel">
          <div class="trade-panel__head">
            <span class="trade-tag trade-tag--sell">sells</span>
          </div>
          {product.sell ? (
            <div class="trade-panel__fields">
              {product.sell.unitPrice !== null && (
                <div>
                  <span class="field-label">unit price</span>
                  <span class="field-value">{product.sell.unitPrice} {product.currency}</span>
                </div>
              )}
              {product.sell.stackPrice !== null && (
                <div>
                  <span class="field-label">stack price (64)</span>
                  <span class="field-value">{product.sell.stackPrice} {product.currency}</span>
                </div>
              )}
              <div>
                <span class="field-label">availability</span>
                <span class="field-value" style={product.sell.quantity === 0 ? 'color:var(--redstone);' : ''}>
                  {product.sell.quantity === 0 ? 'out of stock' : product.sell.quantity}
                </span>
              </div>
            </div>
          ) : (
            <div class="trade-panel--empty">This shop doesn't sell this item.</div>
          )}
        </div>

        <div class="trade-panel">
          <div class="trade-panel__head">
            <span class="trade-tag trade-tag--buy">buys</span>
          </div>
          {product.buy ? (
            <div class="trade-panel__fields">
              {product.buy.unitPrice !== null && (
                <div>
                  <span class="field-label">unit price</span>
                  <span class="field-value">{product.buy.unitPrice} {product.currency}</span>
                </div>
              )}
              {product.buy.stackPrice !== null && (
                <div>
                  <span class="field-label">stack price (64)</span>
                  <span class="field-value">{product.buy.stackPrice} {product.currency}</span>
                </div>
              )}
              <div>
                <span class="field-label">quantity wanted</span>
                <span class="field-value">{product.buy.quantity}</span>
              </div>
            </div>
          ) : (
            <div class="trade-panel--empty">This shop doesn't buy this item back.</div>
          )}
        </div>
      </div>
    </div>
  </div>

  {shop && (
    <div class="panel shop-link-card">
      <div>
        <div class="widget__label">Available at</div>
        <div class="shop-card__name" style="margin-top:4px;">{shop.name}</div>
        <div class="detail-head__meta" style="margin-top:6px;">
          <span class="coord-chip">X {shop.x} · Z {shop.z} · {shop.dimension}</span>
        </div>
      </div>
      <a class="btn btn--primary" href={`/shops/${shop.slug}`}>Go to shop</a>
    </div>
  )}
</BaseLayout>
