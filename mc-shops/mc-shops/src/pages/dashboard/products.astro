---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
---
<BaseLayout title="Products" activeSection="dashboard">
  <Topbar slot="topbar" title="Products" />

  <p class="breadcrumb"><a href="/dashboard">My Shops</a> / <span id="shop-name-crumb">…</span></p>

  <div id="page-guard" class="dashboard-empty">Checking your session…</div>

  <div id="page-content" hidden>
    <div class="shops-toolbar">
      <span class="widget__meta" id="item-count" style="font-size:13px;"></span>
      <button class="btn btn--primary" id="add-item-toggle" type="button">+ Add product</button>
    </div>

    <div id="add-item-panel" class="panel shop-edit" hidden></div>

    <div id="item-list" class="shop-edit-list"></div>
    <div id="no-items" class="dashboard-empty" hidden>No products configured yet — add one above.</div>
  </div>
</BaseLayout>

<script>
  interface CatalogRef {
    name: string;
    category: string;
    image_url: string;
  }

  interface ShopItem {
    id: number;
    minecraft_id: string;
    quantity: number | null;
    compacted_quantity: number | null;
    essence_quantity: string | null;
    sell_amount: number | null;
    sell_price: string | null;
    buy_amount: number | null;
    buy_price: string | null;
    compacted_sell_amount: number | null;
    compacted_sell_price: string | null;
    compacted_buy_amount: number | null;
    compacted_buy_price: string | null;
    catalog: CatalogRef | null;
  }

  const shopId = new URLSearchParams(window.location.search).get('shop');

  const guard = document.getElementById('page-guard') as HTMLElement;
  const content = document.getElementById('page-content') as HTMLElement;
  const shopNameCrumb = document.getElementById('shop-name-crumb') as HTMLElement;
  const itemList = document.getElementById('item-list') as HTMLElement;
  const noItems = document.getElementById('no-items') as HTMLElement;
  const itemCount = document.getElementById('item-count') as HTMLElement;
  const addToggle = document.getElementById('add-item-toggle') as HTMLButtonElement;
  const addPanel = document.getElementById('add-item-panel') as HTMLElement;

  if (!shopId) {
    window.location.replace('/dashboard');
  }

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function itemIcon(catalog: CatalogRef | null, name: string): string {
    const alt = escapeHtml(catalog?.name ?? name);
    const src = catalog?.image_url ?? '';
    return `<span class="item-icon-wrap">
      <img class="item-icon" src="${escapeHtml(src)}" alt="${alt}"
        onerror="this.style.display='none';this.parentElement.classList.add('item-icon-wrap--missing')" />
    </span>`;
  }

  function fmtEssence(value: string | number | null): string {
    if (value === null) return '—';
    return `${Number(value)} Essence`;
  }

  /** Sell capacity is simply the configured stock quantity for that variant. */
  function sellCapacity(quantity: number | string | null): number | null {
    if (quantity === null || quantity === '') return null;
    const n = Number(quantity);
    return Number.isFinite(n) ? n : null;
  }

  /** Buy capacity: how many the merchant can still afford at this rate, given the shared Essence budget. */
  function buyCapacity(essence: number | string | null, price: number | string | null, amount: number | string | null): number | null {
    if (essence === null || essence === '' || price === null || price === '' || amount === null || amount === '') return null;
    const e = Number(essence), p = Number(price), a = Number(amount);
    if (!Number.isFinite(e) || !Number.isFinite(p) || !Number.isFinite(a) || p <= 0) return null;
    return Math.floor((e / p) * a);
  }

  function summaryLine(item: ShopItem): string {
    const parts: string[] = [];
    if (item.sell_amount !== null && item.sell_price !== null) {
      const cap = sellCapacity(item.quantity);
      parts.push(`Sells ${item.sell_amount} for ${fmtEssence(item.sell_price)}${cap !== null ? ` (${cap} available)` : ''}`);
    }
    if (item.compacted_sell_amount !== null && item.compacted_sell_price !== null) {
      const cap = sellCapacity(item.compacted_quantity);
      parts.push(`Compacted sell ${item.compacted_sell_amount} for ${fmtEssence(item.compacted_sell_price)}${cap !== null ? ` (${cap} available)` : ''}`);
    }
    if (item.buy_amount !== null && item.buy_price !== null) {
      const cap = buyCapacity(item.essence_quantity, item.buy_price, item.buy_amount);
      parts.push(`Buys ${item.buy_amount} for ${fmtEssence(item.buy_price)}${cap !== null ? ` (can buy ${cap})` : ''}`);
    }
    if (item.compacted_buy_amount !== null && item.compacted_buy_price !== null) {
      const cap = buyCapacity(item.essence_quantity, item.compacted_buy_price, item.compacted_buy_amount);
      parts.push(`Compacted buy ${item.compacted_buy_amount} for ${fmtEssence(item.compacted_buy_price)}${cap !== null ? ` (can buy ${cap})` : ''}`);
    }
    return parts.length ? parts.join(' · ') : 'No trade modes configured';
  }

  // -- Editable trade-mode fields, shared between the "add" and "edit" forms --
  //
  // Structure: Sell to Player / Buy from Player (top checkboxes), each with
  // Non Compacted / Compacted sub-checkboxes revealing their own Amount+Price.
  // Buy from Player also shows a single shared "Essence Available" field.
  // Capacity (sell: = quantity: buy: = floor(essence/price)*amount) is
  // recalculated live as the merchant types.

  function tradeFieldsHtml(item?: ShopItem): string {
    const sellNormalOn = !!item && item.sell_amount !== null && item.sell_price !== null;
    const sellCompactedOn = !!item && item.compacted_sell_amount !== null && item.compacted_sell_price !== null;
    const sellOn = sellNormalOn || sellCompactedOn;

    const buyNormalOn = !!item && item.buy_amount !== null && item.buy_price !== null;
    const buyCompactedOn = !!item && item.compacted_buy_amount !== null && item.compacted_buy_price !== null;
    const buyOn = buyNormalOn || buyCompactedOn;

    return `
      <label class="mode-toggle"><input type="checkbox" name="sellToggle" ${sellOn ? 'checked' : ''} /> Sell to Player</label>
      <div class="mode-block sell-block" style="${sellOn ? '' : 'display:none;'}">
        <div class="submode-row">
          <label><input type="checkbox" name="sellNormalToggle" ${sellNormalOn ? 'checked' : ''} /> Non Compacted</label>
          <label><input type="checkbox" name="sellCompactedToggle" ${sellCompactedOn ? 'checked' : ''} /> Compacted</label>
        </div>

        <div class="submode-fields sell-normal-fields" style="${sellNormalOn ? '' : 'display:none;'}">
          <div class="shop-edit__row">
            <div class="field"><label>Quantity</label><input name="quantity" type="number" min="0" value="${item?.quantity ?? ''}" /></div>
            <div class="field"><label>Amount</label><input name="sellAmount" type="number" min="0" value="${item?.sell_amount ?? ''}" /></div>
            <div class="field"><label>Price (Essence)</label><input name="sellPrice" type="number" min="0" step="0.01" value="${item?.sell_price ?? ''}" /></div>
          </div>
          <p class="capacity-line" data-capacity="sell-normal">Available for sale: —</p>
        </div>

        <div class="submode-fields sell-compacted-fields" style="${sellCompactedOn ? '' : 'display:none;'}">
          <div class="shop-edit__row">
            <div class="field"><label>Compacted quantity</label><input name="compactedQuantity" type="number" min="0" value="${item?.compacted_quantity ?? ''}" /></div>
            <div class="field"><label>Amount</label><input name="compactedSellAmount" type="number" min="0" value="${item?.compacted_sell_amount ?? ''}" /></div>
            <div class="field"><label>Price (Essence)</label><input name="compactedSellPrice" type="number" min="0" step="0.01" value="${item?.compacted_sell_price ?? ''}" /></div>
          </div>
          <p class="capacity-line" data-capacity="sell-compacted">Available for sale (compacted): —</p>
        </div>
      </div>

      <label class="mode-toggle"><input type="checkbox" name="buyToggle" ${buyOn ? 'checked' : ''} /> Buy from Player</label>
      <div class="mode-block buy-block" style="${buyOn ? '' : 'display:none;'}">
        <div class="submode-row">
          <label><input type="checkbox" name="buyNormalToggle" ${buyNormalOn ? 'checked' : ''} /> Non Compacted</label>
          <label><input type="checkbox" name="buyCompactedToggle" ${buyCompactedOn ? 'checked' : ''} /> Compacted</label>
        </div>

        <div class="field"><label>Essence Available</label>
          <input name="essenceQuantity" type="number" min="0" step="0.01" value="${item?.essence_quantity ?? ''}" /></div>

        <div class="submode-fields buy-normal-fields" style="${buyNormalOn ? '' : 'display:none;'}">
          <div class="shop-edit__row">
            <div></div>
            <div class="field"><label>Amount</label><input name="buyAmount" type="number" min="0" value="${item?.buy_amount ?? ''}" /></div>
            <div class="field"><label>Price (Essence)</label><input name="buyPrice" type="number" min="0" step="0.01" value="${item?.buy_price ?? ''}" /></div>
          </div>
          <p class="capacity-line" data-capacity="buy-normal">Available for purchase: —</p>
        </div>

        <div class="submode-fields buy-compacted-fields" style="${buyCompactedOn ? '' : 'display:none;'}">
          <div class="shop-edit__row">
            <div></div>
            <div class="field"><label>Amount</label><input name="compactedBuyAmount" type="number" min="0" value="${item?.compacted_buy_amount ?? ''}" /></div>
            <div class="field"><label>Price (Essence)</label><input name="compactedBuyPrice" type="number" min="0" step="0.01" value="${item?.compacted_buy_price ?? ''}" /></div>
          </div>
          <p class="capacity-line" data-capacity="buy-compacted">Available for purchase (compacted): —</p>
        </div>
      </div>
    `;
  }

  function wireToggles(root: HTMLElement) {
    const get = (name: string) => root.querySelector(`[name="${name}"]`) as HTMLInputElement;

    const sellToggle = get('sellToggle');
    const sellBlock = root.querySelector('.sell-block') as HTMLElement;
    const sellNormalToggle = get('sellNormalToggle');
    const sellNormalFields = root.querySelector('.sell-normal-fields') as HTMLElement;
    const sellCompactedToggle = get('sellCompactedToggle');
    const sellCompactedFields = root.querySelector('.sell-compacted-fields') as HTMLElement;

    const buyToggle = get('buyToggle');
    const buyBlock = root.querySelector('.buy-block') as HTMLElement;
    const buyNormalToggle = get('buyNormalToggle');
    const buyNormalFields = root.querySelector('.buy-normal-fields') as HTMLElement;
    const buyCompactedToggle = get('buyCompactedToggle');
    const buyCompactedFields = root.querySelector('.buy-compacted-fields') as HTMLElement;

    sellToggle?.addEventListener('change', () => {
      sellBlock.style.display = sellToggle.checked ? '' : 'none';
      if (!sellToggle.checked) { sellNormalToggle.checked = false; sellCompactedToggle.checked = false; sellNormalFields.style.display = 'none'; sellCompactedFields.style.display = 'none'; }
    });
    sellNormalToggle?.addEventListener('change', () => { sellNormalFields.style.display = sellNormalToggle.checked ? '' : 'none'; recalcCapacity(root); });
    sellCompactedToggle?.addEventListener('change', () => { sellCompactedFields.style.display = sellCompactedToggle.checked ? '' : 'none'; recalcCapacity(root); });

    buyToggle?.addEventListener('change', () => {
      buyBlock.style.display = buyToggle.checked ? '' : 'none';
      if (!buyToggle.checked) { buyNormalToggle.checked = false; buyCompactedToggle.checked = false; buyNormalFields.style.display = 'none'; buyCompactedFields.style.display = 'none'; }
    });
    buyNormalToggle?.addEventListener('change', () => { buyNormalFields.style.display = buyNormalToggle.checked ? '' : 'none'; recalcCapacity(root); });
    buyCompactedToggle?.addEventListener('change', () => { buyCompactedFields.style.display = buyCompactedToggle.checked ? '' : 'none'; recalcCapacity(root); });

    root.querySelectorAll('input[type="number"]').forEach((el) => {
      el.addEventListener('input', () => recalcCapacity(root));
    });

    recalcCapacity(root);
  }

  function recalcCapacity(root: HTMLElement) {
    const val = (name: string) => {
      const el = root.querySelector(`[name="${name}"]`) as HTMLInputElement | null;
      return el && el.value !== '' ? el.value : null;
    };
    const setLine = (key: string, text: string) => {
      const el = root.querySelector(`[data-capacity="${key}"]`);
      if (el) el.textContent = text;
    };

    const sellCap = sellCapacity(val('quantity'));
    setLine('sell-normal', `Available for sale: ${sellCap ?? '—'}`);

    const sellCompCap = sellCapacity(val('compactedQuantity'));
    setLine('sell-compacted', `Available for sale (compacted): ${sellCompCap ?? '—'}`);

    const essence = val('essenceQuantity');
    const buyCap = buyCapacity(essence, val('buyPrice'), val('buyAmount'));
    setLine('buy-normal', `Available for purchase: ${buyCap ?? '—'}`);

    const buyCompCap = buyCapacity(essence, val('compactedBuyPrice'), val('compactedBuyAmount'));
    setLine('buy-compacted', `Available for purchase (compacted): ${buyCompCap ?? '—'}`);
  }

  function formToItemPayload(root: HTMLElement, minecraftId: string) {
    const val = (name: string) => (root.querySelector(`[name="${name}"]`) as HTMLInputElement)?.value ?? '';
    const checked = (name: string) => (root.querySelector(`[name="${name}"]`) as HTMLInputElement)?.checked ?? false;
    const orNull = (v: string) => (v === '' ? null : v);

    const sellNormal = checked('sellToggle') && checked('sellNormalToggle');
    const sellCompacted = checked('sellToggle') && checked('sellCompactedToggle');
    const buyOn = checked('buyToggle');
    const buyNormal = buyOn && checked('buyNormalToggle');
    const buyCompacted = buyOn && checked('buyCompactedToggle');

    return {
      minecraftId,
      quantity: sellNormal ? orNull(val('quantity')) : null,
      compactedQuantity: sellCompacted ? orNull(val('compactedQuantity')) : null,
      essenceQuantity: buyOn ? orNull(val('essenceQuantity')) : null,
      sellAmount: sellNormal ? orNull(val('sellAmount')) : null,
      sellPrice: sellNormal ? orNull(val('sellPrice')) : null,
      buyAmount: buyNormal ? orNull(val('buyAmount')) : null,
      buyPrice: buyNormal ? orNull(val('buyPrice')) : null,
      compactedSellAmount: sellCompacted ? orNull(val('compactedSellAmount')) : null,
      compactedSellPrice: sellCompacted ? orNull(val('compactedSellPrice')) : null,
      compactedBuyAmount: buyCompacted ? orNull(val('compactedBuyAmount')) : null,
      compactedBuyPrice: buyCompacted ? orNull(val('compactedBuyPrice')) : null,
    };
  }

  // -- Existing item row (list + inline edit) --

  function buildItemRow(item: ShopItem) {
    const card = document.createElement('div');
    card.className = 'panel shop-edit';
    card.innerHTML = `
      <div class="shop-edit__title" style="display:flex; align-items:center; gap:10px;">
        ${itemIcon(item.catalog, item.minecraft_id)}
        <span>${escapeHtml(item.catalog?.name ?? item.minecraft_id)}</span>
      </div>
      <p class="widget__meta" style="margin:-6px 0 12px;">${escapeHtml(summaryLine(item))}</p>
      <div class="item-edit-form" hidden></div>
      <div class="shop-edit__actions">
        <span class="shop-edit__status"></span>
        <div style="display:flex; gap:10px;">
          <button class="btn" type="button" data-action="toggle-edit">Edit</button>
          <button class="btn" type="button" data-action="delete" style="color:var(--redstone);">Delete</button>
        </div>
      </div>
    `;

    const statusEl = card.querySelector('.shop-edit__status') as HTMLElement;
    const editBox = card.querySelector('.item-edit-form') as HTMLElement;
    const toggleBtn = card.querySelector('[data-action="toggle-edit"]') as HTMLButtonElement;
    const deleteBtn = card.querySelector('[data-action="delete"]') as HTMLButtonElement;

    toggleBtn.addEventListener('click', () => {
      if (editBox.hidden && editBox.innerHTML === '') {
        editBox.innerHTML = `<form>${tradeFieldsHtml(item)}
          <div class="shop-edit__actions"><span class="shop-edit__status" data-role="edit-status"></span>
          <button class="btn btn--primary" type="submit">Save changes</button></div></form>`;
        wireToggles(editBox);

        const form = editBox.querySelector('form') as HTMLFormElement;
        const editStatus = editBox.querySelector('[data-role="edit-status"]') as HTMLElement;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          editStatus.textContent = 'Saving…';
          editStatus.className = 'shop-edit__status';
          try {
            const res = await fetch(`/api/merchant/shops/${shopId}/items/${item.id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify(formToItemPayload(form, item.minecraft_id)),
            });
            const data = await res.json();
            if (!res.ok) {
              editStatus.textContent = data.error ?? 'Could not save.';
              editStatus.className = 'shop-edit__status shop-edit__status--error';
              return;
            }
            editStatus.textContent = 'Saved.';
            editStatus.className = 'shop-edit__status shop-edit__status--ok';
            await loadItems();
          } catch {
            editStatus.textContent = 'Network error.';
            editStatus.className = 'shop-edit__status shop-edit__status--error';
          }
        });
      }
      editBox.hidden = !editBox.hidden;
    });

    deleteBtn.addEventListener('click', async () => {
      if (!confirm(`Remove ${item.catalog?.name ?? item.minecraft_id} from this shop?`)) return;
      statusEl.textContent = 'Deleting…';
      statusEl.className = 'shop-edit__status';
      try {
        const res = await fetch(`/api/merchant/shops/${shopId}/items/${item.id}`, {
          method: 'DELETE',
          credentials: 'same-origin',
        });
        if (!res.ok) {
          statusEl.textContent = 'Could not delete.';
          statusEl.className = 'shop-edit__status shop-edit__status--error';
          return;
        }
        await loadItems();
      } catch {
        statusEl.textContent = 'Network error.';
        statusEl.className = 'shop-edit__status shop-edit__status--error';
      }
    });

    return card;
  }

  // -- Add product panel (catalog search + trade fields) --

  function renderAddPanel() {
    addPanel.innerHTML = `
      <div class="shop-edit__title">Add product</div>
      <div class="field" id="catalog-picker">
        <label>Find an item</label>
        <input type="text" id="catalog-search" placeholder="Search the Minecraft catalog…" autocomplete="off" />
        <div id="catalog-results" class="panel" style="margin-top:6px; padding:8px; display:none; max-height:220px; overflow-y:auto;"></div>
      </div>
      <div id="selected-item" style="display:none; align-items:center; gap:10px; margin-bottom:14px;">
        <span id="selected-item-icon"></span>
        <span id="selected-item-name" style="font-weight:600;"></span>
        <button class="btn" type="button" id="change-item">Change</button>
      </div>
      <form id="add-item-form" hidden>
        <div id="add-item-fields"></div>
        <div class="shop-edit__actions">
          <span class="shop-edit__status" id="add-item-status"></span>
          <button class="btn btn--primary" type="submit">Add to shop</button>
        </div>
      </form>
    `;

    const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
    const results = document.getElementById('catalog-results') as HTMLElement;
    const picker = document.getElementById('catalog-picker') as HTMLElement;
    const selectedBox = document.getElementById('selected-item') as HTMLElement;
    const selectedIcon = document.getElementById('selected-item-icon') as HTMLElement;
    const selectedName = document.getElementById('selected-item-name') as HTMLElement;
    const changeBtn = document.getElementById('change-item') as HTMLButtonElement;
    const form = document.getElementById('add-item-form') as HTMLFormElement;
    const fieldsBox = document.getElementById('add-item-fields') as HTMLElement;
    const addStatus = document.getElementById('add-item-status') as HTMLElement;

    let selectedId = '';
    let debounceTimer: ReturnType<typeof setTimeout>;

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const q = searchInput.value.trim();
        const res = await fetch(`/api/catalog/search?q=${encodeURIComponent(q)}`);
        const data = (await res.json()) as { items: (CatalogRef & { minecraft_id: string })[] };
        const items = data.items;
        results.innerHTML = items
          .map(
            (i) => `<div class="catalog-result" data-id="${escapeHtml(i.minecraft_id)}"
              style="display:flex; align-items:center; gap:8px; padding:6px 4px; cursor:pointer; border-radius:4px;">
              ${itemIcon(i, i.name)} <span>${escapeHtml(i.name)}</span></div>`
          )
          .join('');
        results.style.display = items.length ? 'block' : 'none';

        results.querySelectorAll('.catalog-result').forEach((el) => {
          el.addEventListener('click', () => {
            const id = (el as HTMLElement).dataset.id as string;
            const found = items.find((i) => i.minecraft_id === id);
            if (!found) return;
            selectedId = id;
            selectedIcon.innerHTML = itemIcon(found, found.name);
            selectedName.textContent = found.name;
            picker.style.display = 'none';
            selectedBox.style.display = 'flex';
            fieldsBox.innerHTML = tradeFieldsHtml();
            wireToggles(fieldsBox);
            form.hidden = false;
            results.style.display = 'none';
          });
        });
      }, 250);
    });

    changeBtn.addEventListener('click', () => {
      selectedId = '';
      picker.style.display = '';
      selectedBox.style.display = 'none';
      form.hidden = true;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!selectedId) return;
      addStatus.textContent = 'Adding…';
      addStatus.className = 'shop-edit__status';
      try {
        const res = await fetch(`/api/merchant/shops/${shopId}/items`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(formToItemPayload(fieldsBox, selectedId)),
        });
        const data = await res.json();
        if (!res.ok) {
          addStatus.textContent = data.error ?? 'Could not add the item.';
          addStatus.className = 'shop-edit__status shop-edit__status--error';
          return;
        }
        addStatus.textContent = 'Added.';
        addStatus.className = 'shop-edit__status shop-edit__status--ok';
        addPanel.hidden = true;
        await loadItems();
      } catch {
        addStatus.textContent = 'Network error.';
        addStatus.className = 'shop-edit__status shop-edit__status--error';
      }
    });
  }

  addToggle.addEventListener('click', () => {
    if (addPanel.innerHTML === '') renderAddPanel();
    addPanel.hidden = !addPanel.hidden;
  });

  async function loadItems() {
    const res = await fetch(`/api/merchant/shops/${shopId}/items`, { credentials: 'same-origin' });
    if (!res.ok) throw new Error('unauthorized_or_forbidden');
    const data = (await res.json()) as { shop: { name: string }; items: ShopItem[] };

    shopNameCrumb.textContent = data.shop.name;
    itemList.innerHTML = '';
    itemCount.textContent = `${data.items.length} product${data.items.length === 1 ? '' : 's'}`;
    noItems.hidden = data.items.length > 0;

    for (const item of data.items) {
      itemList.appendChild(buildItemRow(item));
    }
  }

  (async () => {
    try {
      const me = await fetch('/api/auth/me', { credentials: 'same-origin' });
      if (!me.ok) {
        window.location.replace('/login');
        return;
      }
      await loadItems();
      guard.hidden = true;
      content.hidden = false;
    } catch {
      guard.textContent = "Couldn't load this shop — it may not exist or may not belong to you.";
    }
  })();
</script>
