---
import '@/styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vendor Login · EdenShop</title>
  </head>
  <body>
    <div class="login-shell">
      <div class="login-card">
        <div class="login-card__brand">
          <div class="brand-mark"></div>
          <span class="brand-text">EdenShop</span>
        </div>
        <h1>Vendor Login</h1>
        <p class="sub">Log in to manage your shop and update your products.</p>

        <form>
          <div class="field">
            <label for="username">Minecraft username</label>
            <input id="username" name="username" type="text" placeholder="E.g. Steve_IT" autocomplete="username" />
          </div>
          <div class="field">
            <label for="password">Access code</label>
            <input id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" />
          </div>
          <button class="btn btn--primary" type="submit">Log in</button>
        </form>

        <a class="login-back" href="/">← back to home</a>
      </div>
    </div>
  </body>
</html>
