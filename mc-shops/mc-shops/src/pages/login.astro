---
import '@/styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vendor Login · EdenShop</title>
  </head>
  <body>
    <div class="login-shell">
      <div class="login-card">
        <div class="login-card__brand">
          <div class="brand-mark"></div>
          <span class="brand-text">EdenShop</span>
        </div>
        <h1>Vendor Login</h1>
        <p class="sub">Log in with Discord to manage your shop and update your products.</p>

        <div id="login-status" class="login-status" hidden></div>

        <a class="btn btn--primary login-discord-btn" href="/api/auth/discord">Continue with Discord</a>

        <a class="login-back" href="/">← back to home</a>
      </div>
    </div>

    <script>
      const params = new URLSearchParams(window.location.search);
      const status = params.get('status');
      const statusEl = document.getElementById('login-status');

      if (statusEl && status === 'pending') {
        statusEl.textContent = 'Your account is waiting for approval. You’ll be able to log in once a server admin approves it.';
        statusEl.classList.add('login-status--pending');
        statusEl.hidden = false;
      } else if (statusEl && status === 'error') {
        statusEl.textContent = 'Something went wrong with Discord login. Please try again.';
        statusEl.classList.add('login-status--error');
        statusEl.hidden = false;
      } else {
        // If already logged in, skip the login page entirely.
        fetch('/api/auth/me', { credentials: 'same-origin' })
          .then((res) => { if (res.ok) window.location.replace('/'); })
          .catch(() => {});
      }
    </script>
  </body>
</html>
