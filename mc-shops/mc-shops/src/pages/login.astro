---
import ThemeToggle from '@/components/ThemeToggle.astro';
import '@/styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vendor Login · EdenShop</title>
    <script is:inline src="/site.js"></script>
  </head>
  <body>
    <div class="login-shell">
      <div class="login-card">
        <div class="login-card__brand">
          <div class="brand-mark"></div>
          <span class="brand-text">EdenShop</span>
          <ThemeToggle />
        </div>
        <h1>Vendor Login</h1>
        <p class="sub">Log in with Discord to manage your shop and update your products.</p>

        <div id="login-status" class="login-status" hidden></div>

        <a class="btn btn--primary login-discord-btn" href="/api/auth/discord">Continue with Discord</a>

        <a class="login-back" href="/">← back to home</a>
      </div>
    </div>

    <!-- External file on purpose: Astro would inline this small script, and the CSP (script-src 'self') blocks inline scripts. -->
    <script is:inline src="/login.js"></script>
  </body>
</html>
