---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
import { products, getProductBySlug, getShopBySlug } from '@/lib/mockData';
import { getCatalogItem } from '@/lib/items';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug as string);
if (!product) return Astro.redirect('/prodotti');
const shop = getShopBySlug(product.shopSlug);
const item = getCatalogItem(product.minecraftId);
const displayName = item?.name ?? product.minecraftId;
---
<BaseLayout title={displayName} activeSection="prodotti">
  <Topbar slot="topbar" title={displayName} />

  <p class="breadcrumb"><a href="/prodotti">Prodotti</a> / {displayName}</p>

  <div class="panel product-detail__panel">
    <img class="item-icon item-icon--lg" src={item?.image_url} alt={displayName} />
    <div style="flex:1;">
      <h1 style="margin-bottom:4px;">{displayName}</h1>
      <div class="widget__meta">{item?.category ?? 'categoria sconosciuta'} · {product.minecraftId}</div>

      <div class="trade-columns">
        <div class="trade-panel">
          <div class="trade-panel__head">
            <span class="trade-tag trade-tag--sell">vende</span>
          </div>
          {product.sell ? (
            <div class="trade-panel__fields">
              {product.sell.unitPrice !== null && (
                <div>
                  <span class="field-label">prezzo a unità</span>
                  <span class="field-value">{product.sell.unitPrice} {product.currency}</span>
                </div>
              )}
              {product.sell.stackPrice !== null && (
                <div>
                  <span class="field-label">prezzo a stack (64)</span>
                  <span class="field-value">{product.sell.stackPrice} {product.currency}</span>
                </div>
              )}
              <div>
                <span class="field-label">disponibilità</span>
                <span class="field-value" style={product.sell.quantity === 0 ? 'color:var(--redstone);' : ''}>
                  {product.sell.quantity === 0 ? 'esaurito' : product.sell.quantity}
                </span>
              </div>
            </div>
          ) : (
            <div class="trade-panel--empty">Questo negozio non vende questo oggetto.</div>
          )}
        </div>

        <div class="trade-panel">
          <div class="trade-panel__head">
            <span class="trade-tag trade-tag--buy">compra</span>
          </div>
          {product.buy ? (
            <div class="trade-panel__fields">
              {product.buy.unitPrice !== null && (
                <div>
                  <span class="field-label">prezzo a unità</span>
                  <span class="field-value">{product.buy.unitPrice} {product.currency}</span>
                </div>
              )}
              {product.buy.stackPrice !== null && (
                <div>
                  <span class="field-label">prezzo a stack (64)</span>
                  <span class="field-value">{product.buy.stackPrice} {product.currency}</span>
                </div>
              )}
              <div>
                <span class="field-label">quantità richiesta</span>
                <span class="field-value">{product.buy.quantity}</span>
              </div>
            </div>
          ) : (
            <div class="trade-panel--empty">Questo negozio non ricompra questo oggetto.</div>
          )}
        </div>
      </div>
    </div>
  </div>

  {shop && (
    <div class="panel shop-link-card">
      <div>
        <div class="widget__label">Disponibile presso</div>
        <div class="shop-card__name" style="margin-top:4px;">{shop.name}</div>
        <div class="detail-head__meta" style="margin-top:6px;">
          <span class="coord-chip">X {shop.x} · Z {shop.z} · {shop.dimension}</span>
        </div>
      </div>
      <a class="btn btn--primary" href={`/negozi/${shop.slug}`}>Vai al negozio</a>
    </div>
  )}
</BaseLayout>
