---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
import ShopCard from '@/components/ShopCard.astro';
import { shops } from '@/lib/mockData';
---
<BaseLayout title="Shops" activeSection="shops">
  <Topbar slot="topbar" title="Shops" />

  <p class="page-lede">
    All shops registered on the server. Open a shop to see its location,
    description, directions and its product list.
  </p>

  <div class="toolbar">
    <span class="widget__meta" style="font-size:13px;">{shops.length} registered shops</span>
  </div>

  <div class="shop-grid">
    {shops.map((shop) => <ShopCard shop={shop} />)}
  </div>
</BaseLayout>
