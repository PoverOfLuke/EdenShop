---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
---
<BaseLayout title="Shops" activeSection="shops">
  <Topbar slot="topbar" title="Shops" />

  <p class="page-lede">
    All shops registered on the server. Open a shop to see its location,
    description, directions and its product list.
  </p>

  <div class="toolbar">
    <span class="widget__meta" id="shop-count" style="font-size:13px;"></span>
  </div>

  <div id="shops-loading" class="dashboard-empty">Loading shops…</div>
  <div class="shop-grid" id="shop-grid"></div>
  <div class="dashboard-empty" id="no-shops" hidden>No shops registered yet.</div>
</BaseLayout>

<script>
  interface Shop {
    id: number; name: string; slug: string; x: number | null; z: number | null; description: string | null;
    country_name: string | null; city_name: string | null;
  }

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  (async () => {
    const loading = document.getElementById('shops-loading') as HTMLElement;
    const grid = document.getElementById('shop-grid') as HTMLElement;
    const empty = document.getElementById('no-shops') as HTMLElement;
    const count = document.getElementById('shop-count') as HTMLElement;

    try {
      const res = await fetch('/api/shops');
      const { shops } = (await res.json()) as { shops: Shop[] };

      count.textContent = `${shops.length} registered shop${shops.length === 1 ? '' : 's'}`;
      loading.hidden = true;
      empty.hidden = shops.length > 0;

      grid.innerHTML = shops
        .map(
          (s) => `
        <a class="shop-card" href="/shops/detail?slug=${encodeURIComponent(s.slug)}">
          <div class="shop-card__head">
            <div><div class="shop-card__name">${escapeHtml(s.name)}</div></div>
          </div>
          ${s.description ? `<p class="shop-card__desc">${escapeHtml(s.description)}</p>` : ''}
          <div class="shop-location">${s.country_name ? escapeHtml(s.city_name ? `${s.country_name} · ${s.city_name}` : s.country_name) : 'Location not specified'}</div>
          <div class="shop-card__coords">X ${s.x ?? '—'} · Z ${s.z ?? '—'}</div>
        </a>`
        )
        .join('');
    } catch {
      loading.textContent = "Couldn't load shops right now.";
    }
  })();
</script>
