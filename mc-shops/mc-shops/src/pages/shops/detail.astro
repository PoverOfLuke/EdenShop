---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
---
<BaseLayout title="Shop" activeSection="shops">
  <Topbar slot="topbar" title="Shop" />

  <p class="breadcrumb"><a href="/shops">Shops</a> / <span id="crumb">…</span></p>

  <div id="shop-loading" class="dashboard-empty">Loading shop…</div>

  <div id="shop-content" hidden>
    <div class="detail-head">
      <div>
        <h1 id="shop-name" style="margin-bottom:2px;"></h1>
        <div class="detail-head__meta">
          <span class="coord-chip" id="shop-coords"></span>
        </div>
        <div class="shop-location" id="shop-location"></div>
      </div>
    </div>

    <div class="info-columns">
      <div class="panel">
        <div class="panel__title">Description</div>
        <p id="shop-description"></p>
      </div>
      <div class="panel">
        <div class="panel__title">How to get there</div>
        <p id="shop-directions"></p>
      </div>
    </div>

    <div class="section-heading">
      <h2>Shop products</h2>
      <span class="section-heading__count" id="item-count"></span>
    </div>

    <div class="product-grid" id="item-grid"></div>
    <div class="empty-state" id="no-items" hidden>
      <div class="empty-state__icon"></div>
      No products for sale right now.
    </div>
  </div>
</BaseLayout>

<script>
  interface ShopItem {
    id: number; minecraft_id: string;
    quantity: number | null; compacted_quantity: number | null; essence_quantity: string | null;
    sell_amount: number | null; sell_price: string | null;
    buy_amount: number | null; buy_price: string | null;
    compacted_sell_amount: number | null; compacted_sell_price: string | null;
    compacted_buy_amount: number | null; compacted_buy_price: string | null;
    catalog: { name: string; image_url: string } | null;
  }

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function itemIcon(catalog: { name: string; image_url: string } | null, fallbackName: string): string {
    const alt = escapeHtml(catalog?.name ?? fallbackName);
    const src = catalog?.image_url ?? '';
    return `<span class="item-icon-wrap">
      <img class="item-icon" src="${escapeHtml(src)}" alt="${alt}" />
    </span>`;
  }

  function buyCapacity(essence: string | null, price: string | null, amount: number | null): number | null {
    if (essence === null || price === null || amount === null) return null;
    const e = Number(essence), p = Number(price);
    if (!p) return null;
    return Math.floor((e / p) * amount);
  }

  /** Only rendered when at least one of the two modes is actually configured. */
  function tradeGroupHtml(label: string, tagClass: string, lines: string[]): string {
    if (lines.length === 0) return '';
    return `<div class="trade-group">
      <span class="trade-group__label ${tagClass}">${label}</span>
      ${lines.join('')}
    </div>`;
  }

  function cardHtml(i: ShopItem): string {
    const name = i.catalog?.name ?? i.minecraft_id;

    const sellLines: string[] = [];
    if (i.sell_amount !== null && i.sell_price !== null) {
      const available = i.quantity === 0 ? 'Out of stock' : String(i.quantity ?? '—');
      sellLines.push(`<div class="trade-subline"><strong>Non Compacted</strong> ${i.sell_amount} → ${i.sell_price} Essence
        <span class="capacity-line">Available: ${available}</span></div>`);
    }
    if (i.compacted_sell_amount !== null && i.compacted_sell_price !== null) {
      const available = i.compacted_quantity === 0 ? 'Out of stock' : String(i.compacted_quantity ?? '—');
      sellLines.push(`<div class="trade-subline"><strong>Compacted</strong> ${i.compacted_sell_amount} → ${i.compacted_sell_price} Essence
        <span class="capacity-line">Available: ${available}</span></div>`);
    }

    const buyLines: string[] = [];
    if (i.buy_amount !== null && i.buy_price !== null) {
      const cap = buyCapacity(i.essence_quantity, i.buy_price, i.buy_amount);
      buyLines.push(`<div class="trade-subline"><strong>Non Compacted</strong> ${i.buy_amount} → ${i.buy_price} Essence
        ${cap !== null ? `<span class="capacity-line">Shop can still buy: ${cap}</span>` : ''}</div>`);
    }
    if (i.compacted_buy_amount !== null && i.compacted_buy_price !== null) {
      const cap = buyCapacity(i.essence_quantity, i.compacted_buy_price, i.compacted_buy_amount);
      buyLines.push(`<div class="trade-subline"><strong>Compacted</strong> ${i.compacted_buy_amount} → ${i.compacted_buy_price} Essence
        ${cap !== null ? `<span class="capacity-line">Shop can still buy: ${cap}</span>` : ''}</div>`);
    }

    return `<a class="product-card" href="/products/detail?id=${i.id}">
      <div class="product-card__top">${itemIcon(i.catalog, i.minecraft_id)}
        <div><div class="product-card__name">${escapeHtml(name)}</div></div></div>
      <div class="product-card__trades">
        ${tradeGroupHtml('SELL TO PLAYER', 'trade-tag--sell', sellLines)}
        ${tradeGroupHtml('BUY FROM PLAYER', 'trade-tag--buy', buyLines)}
      </div>
    </a>`;
  }

  // Links use the numeric shop id: /shops/detail?id=12
  // Old links shared before slugs became internal (?slug=...) still work: they are
  // resolved once and the address bar is then switched to the id form.
  const params = new URLSearchParams(window.location.search);
  const idParam = params.get('id');
  const legacySlug = params.get('slug');

  function itemsEndpoint(): string | null {
    if (idParam && /^\d+$/.test(idParam)) return `/api/shops/by-id/${idParam}/items`;
    if (legacySlug) return `/api/shops/${encodeURIComponent(legacySlug)}/items`;
    return null;
  }

  (async () => {
    const loading = document.getElementById('shop-loading') as HTMLElement;
    const endpoint = itemsEndpoint();
    if (!endpoint) { loading.textContent = 'Shop not found.'; return; }

    try {
      const res = await fetch(endpoint);
      if (!res.ok) { loading.textContent = 'Shop not found.'; return; }
      const data = (await res.json()) as {
        shop: {
          id: number; name: string; x: number | null; z: number | null; description: string | null; directions: string | null;
          country_name: string | null; city_name: string | null;
        };
        items: ShopItem[];
      };

      if (!idParam) {
        // Legacy ?slug= link: drop the slug from the address bar.
        history.replaceState(null, '', `/shops/detail?id=${data.shop.id}`);
      }

      (document.getElementById('crumb') as HTMLElement).textContent = data.shop.name;
      (document.getElementById('shop-name') as HTMLElement).textContent = data.shop.name;
      (document.getElementById('shop-coords') as HTMLElement).textContent = `X ${data.shop.x ?? '—'} · Z ${data.shop.z ?? '—'}`;
      (document.getElementById('shop-description') as HTMLElement).textContent = data.shop.description || 'No description yet.';
      (document.getElementById('shop-directions') as HTMLElement).textContent = data.shop.directions || 'No directions yet.';

      const locationEl = document.getElementById('shop-location') as HTMLElement;
      if (data.shop.country_name) {
        locationEl.textContent = data.shop.city_name ? `${data.shop.country_name} · ${data.shop.city_name}` : data.shop.country_name;
      } else {
        locationEl.textContent = 'Location not specified';
      }

      const grid = document.getElementById('item-grid') as HTMLElement;
      const noItems = document.getElementById('no-items') as HTMLElement;
      (document.getElementById('item-count') as HTMLElement).textContent = `${data.items.length} item${data.items.length === 1 ? '' : 's'}`;
      noItems.hidden = data.items.length > 0;

      grid.innerHTML = data.items.map(cardHtml).join('');

      loading.hidden = true;
      (document.getElementById('shop-content') as HTMLElement).hidden = false;
    } catch {
      loading.textContent = "Couldn't load this shop right now.";
    }
  })();
</script>
