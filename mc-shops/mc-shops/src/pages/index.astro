---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
import { shops, products } from '@/lib/mockData';
import { getCatalogItem } from '@/lib/items';

const onlineShops = shops.filter((s) => s.online).length;
const outOfStock = products.filter((p) => p.sell && p.sell.quantity === 0).length;
const lowStock = products
  .filter((p) => p.sell && p.sell.quantity > 0 && p.sell.quantity <= 20)
  .sort((a, b) => (a.sell?.quantity ?? 0) - (b.sell?.quantity ?? 0));

const totalValue = products.reduce(
  (sum, p) => sum + (p.sell?.unitPrice ?? 0) * (p.sell?.quantity ?? 0),
  0
);

const recentActivity = [...shops]
  .sort((a, b) => new Date(b.lastUpdated).getTime() - new Date(a.lastUpdated).getTime())
  .slice(0, 6);

function timeAgo(iso: string) {
  const diffMin = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
  if (diffMin < 60) return `${diffMin} min fa`;
  const diffH = Math.round(diffMin / 60);
  return `${diffH} h fa`;
}
---
<BaseLayout title="Home" activeSection="home">
  <Topbar slot="topbar" title="Home" />

  <p class="page-lede">
    Panoramica dei negozi collegati al server EdenShop. I dati arrivano dagli
    aggiornamenti inviati su Discord e sincronizzati nel database — qui sotto
    sono mostrati valori di esempio.
  </p>

  <section class="widget-grid" aria-label="Statistiche generali">
    <div class="widget">
      <div class="widget__label">Negozi attivi</div>
      <div class="widget__value widget__value--accent">{onlineShops}<span style="color:var(--text-faint); font-size:16px;"> / {shops.length}</span></div>
      <div class="widget__meta">registrati sul server</div>
    </div>
    <div class="widget">
      <div class="widget__label">Prodotti in catalogo</div>
      <div class="widget__value">{products.length}</div>
      <div class="widget__meta">tra tutti i negozi</div>
    </div>
    <div class="widget">
      <div class="widget__label">Valore totale in vendita</div>
      <div class="widget__value">{totalValue.toFixed(1)}<span style="color:var(--text-faint); font-size:15px;"> Essence</span></div>
      <div class="widget__meta">stima a prezzo unitario</div>
    </div>
    <div class="widget">
      <div class="widget__label">Prodotti esauriti</div>
      <div class={`widget__value ${outOfStock > 0 ? 'widget__value--warn' : ''}`}>{outOfStock}</div>
      <div class="widget__meta">da rifornire</div>
    </div>
  </section>

  <div class="home-columns">
    <div class="panel">
      <div class="panel__title">
        Attività recente
        <a href="/negozi" style="font-size:12px; font-weight:500;">tutti i negozi</a>
      </div>
      <ul class="activity-list">
        {recentActivity.map((s) => (
          <li>
            <span>
              <strong>{s.name}</strong> — {s.online ? 'aggiornamento prezzi' : 'negozio segnato offline'}
            </span>
            <time>{timeAgo(s.lastUpdated)}</time>
          </li>
        ))}
      </ul>
    </div>

    <div style="display:flex; flex-direction:column; gap:14px;">
      <div class="panel">
        <div class="panel__title">Scorte in esaurimento</div>
        {lowStock.length === 0 ? (
          <p style="color:var(--text-dim); font-size:13.5px; margin:0;">Nessun prodotto sotto soglia al momento.</p>
        ) : (
          <ul class="lowstock-list">
            {lowStock.slice(0, 5).map((p) => (
              <li>
                <a href={`/prodotti/${p.slug}`}>{getCatalogItem(p.minecraftId)?.name ?? p.minecraftId}</a>
                <span class="lowstock-qty lowstock-qty--zero">{p.sell?.quantity} rimasti</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="panel">
        <div class="panel__title">Negozi online</div>
        <ul class="shops-mini-list">
          {shops.filter((s) => s.online).slice(0, 5).map((s) => (
            <li>
              <a href={`/negozi/${s.slug}`}>{s.name}</a>
              <span class="shop-coords">X {s.x} Z {s.z}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
