---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Topbar from '@/components/Topbar.astro';
---
<BaseLayout title="Home" activeSection="home">
  <Topbar slot="topbar" title="Home" />

  <p class="page-lede">
    Overview of the shops registered on the EdenShop server, built from live data.
  </p>

  <div id="home-loading" class="dashboard-empty">Loading…</div>

  <div id="home-content" hidden>
    <section class="widget-grid" aria-label="General statistics">
      <div class="widget">
        <div class="widget__label">Registered shops</div>
        <div class="widget__value widget__value--accent" id="stat-shops">0</div>
        <div class="widget__meta">on the server</div>
      </div>
      <div class="widget">
        <div class="widget__label">Products configured</div>
        <div class="widget__value" id="stat-products">0</div>
        <div class="widget__meta">across all shops</div>
      </div>
      <div class="widget">
        <div class="widget__label">Total value for sale</div>
        <div class="widget__value" id="stat-value">0<span style="color:var(--text-faint); font-size:15px;"> Essence</span></div>
        <div class="widget__meta">estimated at unit price</div>
      </div>
      <div class="widget">
        <div class="widget__label">Out of stock</div>
        <div class="widget__value" id="stat-outofstock">0</div>
        <div class="widget__meta">need restocking</div>
      </div>
    </section>

    <div class="home-columns">
      <div class="panel">
        <div class="panel__title">
          Newest shops
          <a href="/shops" style="font-size:12px; font-weight:500;">all shops</a>
        </div>
        <ul class="activity-list" id="newest-shops"></ul>
      </div>

      <div class="panel">
        <div class="panel__title">Low stock</div>
        <ul class="lowstock-list" id="low-stock"></ul>
        <p class="widget__meta" id="low-stock-empty" hidden>No products under threshold right now.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  interface Shop { id: number; name: string; slug: string; x: number | null; z: number | null; created_at: string; }
  interface ShopItem {
    id: number; minecraft_id: string; quantity: number | null; sell_price: string | null;
    catalog: { name: string; image_url: string } | null;
  }

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  (async () => {
    try {
      const [shopsRes, productsRes] = await Promise.all([
        fetch('/api/shops'),
        fetch('/api/products'),
      ]);
      const { shops } = (await shopsRes.json()) as { shops: Shop[] };
      const { items } = (await productsRes.json()) as { items: ShopItem[] };

      (document.getElementById('stat-shops') as HTMLElement).textContent = String(shops.length);
      (document.getElementById('stat-products') as HTMLElement).textContent = String(items.length);

      const totalValue = items.reduce((sum, i) => {
        const price = i.sell_price !== null ? Number(i.sell_price) : 0;
        const qty = i.quantity !== null ? Number(i.quantity) : 0;
        return sum + price * qty;
      }, 0);
      (document.getElementById('stat-value') as HTMLElement).innerHTML =
        `${totalValue.toFixed(1)}<span style="color:var(--text-faint); font-size:15px;"> Essence</span>`;

      const outOfStock = items.filter((i) => i.sell_price !== null && (i.quantity ?? 0) === 0).length;
      (document.getElementById('stat-outofstock') as HTMLElement).textContent = String(outOfStock);

      const newestShopsEl = document.getElementById('newest-shops') as HTMLElement;
      newestShopsEl.innerHTML = shops.slice(0, 6)
        .map((s) => `<li><span><strong>${escapeHtml(s.name)}</strong> — new shop</span><time>${new Date(s.created_at).toLocaleDateString()}</time></li>`)
        .join('') || '<li>No shops yet.</li>';

      const lowStock = items
        .filter((i) => i.sell_price !== null && (i.quantity ?? 0) > 0 && (i.quantity ?? 0) <= 20)
        .sort((a, b) => (a.quantity ?? 0) - (b.quantity ?? 0))
        .slice(0, 5);
      const lowStockEl = document.getElementById('low-stock') as HTMLElement;
      const lowStockEmpty = document.getElementById('low-stock-empty') as HTMLElement;
      lowStockEmpty.hidden = lowStock.length > 0;
      lowStockEl.innerHTML = lowStock
        .map((i) => `<li><a href="/products/detail?id=${i.id}">${escapeHtml(i.catalog?.name ?? i.minecraft_id)}</a><span class="lowstock-qty lowstock-qty--zero">${i.quantity} left</span></li>`)
        .join('');

      document.getElementById('home-loading')!.hidden = true;
      document.getElementById('home-content')!.hidden = false;
    } catch {
      document.getElementById('home-loading')!.textContent = "Couldn't load live data right now.";
    }
  })();
</script>
