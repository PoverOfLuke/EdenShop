---
import type { Shop } from '@/lib/types';
import { getProductsByShop } from '@/lib/mockData';

interface Props { shop: Shop }
const { shop } = Astro.props as Props;
const productCount = getProductsByShop(shop.slug).length;
---
<a class="shop-card" href={`/shops/${shop.slug}`}>
  <div class="shop-card__head">
    <div>
      <div class="shop-card__name">{shop.name}</div>
      <div class="shop-card__owner">run by {shop.owner}</div>
    </div>
    <span class={`badge ${shop.online ? 'badge--online' : 'badge--offline'}`}>
      {shop.online ? 'online' : 'offline'}
    </span>
  </div>

  <p class="shop-card__desc">{shop.description}</p>

  <div class="shop-card__coords">
    X {shop.x} · Z {shop.z} · {shop.dimension} · {productCount} products
  </div>
</a>
