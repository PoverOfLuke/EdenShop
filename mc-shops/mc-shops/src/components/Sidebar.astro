---
interface Props {
  active: 'dashboard' | 'negozi' | 'prodotti' | 'login';
}
const { active } = Astro.props as Props;

const links = [
  { key: 'dashboard', href: '/', label: 'Dashboard' },
  { key: 'negozi', href: '/negozi', label: 'Negozi' },
  { key: 'prodotti', href: '/prodotti', label: 'Prodotti' },
] as const;
---
<aside class="sidebar">
  <div class="sidebar__brand">
    <div class="sidebar__brand-mark"></div>
    <div>
      <span class="sidebar__brand-text">Ledger</span>
      <span class="sidebar__brand-sub">gestione negozi</span>
    </div>
  </div>

  <nav class="sidebar__nav" aria-label="Navigazione principale">
    {links.map((l) => (
      <a
        class="nav-link"
        href={l.href}
        aria-current={active === l.key ? 'page' : undefined}
      >
        <span class="nav-link__icon"></span>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="sidebar__nav">
    <a class="nav-link" href="/login" aria-current={active === 'login' ? 'page' : undefined}>
      <span class="nav-link__icon"></span>
      Accesso venditori
    </a>
  </div>

  <div class="sidebar__footer">
    <span class="sidebar__status">
      <span class="status-dot"></span>
      dati aggiornati via Discord
    </span>
  </div>
</aside>
