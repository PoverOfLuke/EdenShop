---
import type { Product } from '@/lib/types';
import { getShopBySlug } from '@/lib/mockData';
import { getCatalogItem } from '@/lib/items';

interface Props { product: Product }
const { product } = Astro.props as Props;
const shop = getShopBySlug(product.shopSlug);
const item = getCatalogItem(product.minecraftId);
const displayName = item?.name ?? product.minecraftId;
---
<a
  class="product-card"
  href={`/products/${product.slug}`}
  data-name={displayName.toLowerCase()}
  data-category={item?.category ?? ''}
  data-shop={product.shopSlug}
  data-type={`${product.sell ? 'sell' : ''} ${product.buy ? 'buy' : ''}`.trim()}
>
  <div class="product-card__top">
    <span class="item-icon-wrap">
      <img
        class="item-icon"
        src={item?.image_url}
        alt={displayName}
        loading="lazy"
        onerror="this.style.display='none';this.parentElement.classList.add('item-icon-wrap--missing')"
      />
    </span>
    <div>
      <div class="product-card__name">{displayName}</div>
      <div class="product-card__shop">{shop?.name ?? 'unknown shop'}</div>
    </div>
  </div>

  <div class="product-card__trades">
    {product.sell && (
      <div class="trade-row">
        <div class="trade-row__left">
          <span class="trade-tag trade-tag--sell">sells</span>
          <span class={`stock ${product.sell.quantity === 0 ? 'stock--zero' : ''}`}>
            {product.sell.quantity === 0 ? 'out of stock' : `${product.sell.quantity} in stock`}
          </span>
        </div>
        <span class="price">
          {product.sell.unitPrice !== null && (
            <span class="price__unit">{product.sell.unitPrice} {product.currency}<span style="color:var(--text-faint); font-weight:400;"> /ea</span></span>
          )}
          {product.sell.stackPrice !== null && (
            <span class="price__stack">{product.sell.stackPrice} {product.currency} / stack of 64</span>
          )}
        </span>
      </div>
    )}
    {product.buy && (
      <div class="trade-row">
        <div class="trade-row__left">
          <span class="trade-tag trade-tag--buy">buys</span>
          <span class="stock">wants {product.buy.quantity}</span>
        </div>
        <span class="price">
          {product.buy.unitPrice !== null && (
            <span class="price__unit">{product.buy.unitPrice} {product.currency}<span style="color:var(--text-faint); font-weight:400;"> /ea</span></span>
          )}
          {product.buy.stackPrice !== null && (
            <span class="price__stack">{product.buy.stackPrice} {product.currency} / stack of 64</span>
          )}
        </span>
      </div>
    )}
  </div>
</a>
