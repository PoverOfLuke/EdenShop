---
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  active: 'home' | 'shops' | 'products' | 'login' | 'dashboard';
}
const { active } = Astro.props as Props;

const links = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'shops', href: '/shops', label: 'Shops' },
  { key: 'products', href: '/products', label: 'Products' },
] as const;
---
<header class="navbar">
  <div class="navbar__left">
    <a class="brand" href="/">
      <span class="brand-mark"></span>
      <span class="brand-text">EdenShop</span>
    </a>
    <ThemeToggle />
  </div>

  <nav class="navbar__links" aria-label="Main navigation">
    {links.map((l) => (
      <a
        class="nav-link"
        href={l.href}
        aria-current={active === l.key ? 'page' : undefined}
      >
        {l.label}
      </a>
    ))}
  </nav>

  <div class="navbar__right">
    <div id="nav-auth-area" class="navbar__auth">
      <a class="btn btn--primary" href="/login">Vendor Login</a>
    </div>
  </div>
</header>

<script>
  // The navbar is static HTML (built once at build time), so it always
  // starts in the "logged out" state above. This script checks the
  // session client-side and swaps in the merchant's name + a shortcut
  // to their shop dashboard when a valid session is found.
  (async () => {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
      if (!res.ok) return;
      const data = (await res.json()) as { display_name?: string; is_admin?: boolean };

      const area = document.getElementById('nav-auth-area');
      if (!area) return;
      area.innerHTML = '';

      if (data.is_admin) {
        const adminLink = document.createElement('a');
        adminLink.className = 'btn';
        adminLink.href = '/admin';
        adminLink.textContent = 'Admin';
        area.appendChild(adminLink);
      }

      const manageLink = document.createElement('a');
      manageLink.className = 'btn btn--primary';
      manageLink.href = '/dashboard';
      manageLink.textContent = 'Manage Shops';

      const userBlock = document.createElement('span');
      userBlock.className = 'navbar__user';

      const nameEl = document.createElement('span');
      nameEl.className = 'navbar__user-name';
      nameEl.textContent = data.display_name ?? 'Merchant';

      const logoutLink = document.createElement('a');
      logoutLink.className = 'navbar__logout';
      logoutLink.href = '/api/auth/logout';
      logoutLink.textContent = 'Log out';

      userBlock.appendChild(nameEl);
      userBlock.appendChild(logoutLink);

      area.appendChild(manageLink);
      area.appendChild(userBlock);
    } catch {
      // Not logged in, or the API is unreachable — leave the login button as is.
    }
  })();
</script>
