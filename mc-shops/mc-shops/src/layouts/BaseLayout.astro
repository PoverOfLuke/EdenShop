---
import Navbar from '@/components/Navbar.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  activeSection?: 'home' | 'shops' | 'products' | 'login' | 'dashboard';
}

const { title, activeSection = 'home' } = Astro.props as Props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · EdenShop</title>
    <meta name="description" content="Management dashboard for the EdenShop Minecraft server's shops." />
  </head>
  <body>
    <div class="site-shell">
      <Navbar active={activeSection} />
      <slot name="topbar" />
      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>
